## Ignoring Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (DotSettings)
*.DotSettings.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Xx]64/
[Xx]86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Pp]ublish/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esults/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build Complexity Plan files
_Chutzpah*

# Visual Studio 2015 web project package manager node modules directory
node_modules/

# Visual Studio 2015 Auto-generated Code Coverage reports
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass)
.sass-cache/

# Installshield output folder
[Ee]xpress/

# DocProject is a documentation generator for .NET
DocProject/buildhelp/
DocProject/Help/*.mcgh

# Redgate's SQL Toolbelt
*.sqlproj.user
*.query

# Actipro Software ENRE (Enhanced .NET Runtime Environment)
*.enre

# AllYourBase
*.ayb

# Bolt
[Bb]olt/

# CodeSmith
*.CS23

# EF Core Migrations
*.designer.cs

# JustMock
*.jm

# JustCode
.justcode

# Telerik
*.telerik

# NHibernate
*.hbm.xml

# StyleCop
StyleCop.Cache

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# TeamCity
_TeamCity*

# DotCover
*.dotCover

# AxoCover
.axoCover/*

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Godot
.import/
export.cfg
export_presets.cfg

# Unreal Engine
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
*.uproject
*.uplugin

# macOS-specific
.DS_Store

# Windows-specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Project specific logs
*.log
